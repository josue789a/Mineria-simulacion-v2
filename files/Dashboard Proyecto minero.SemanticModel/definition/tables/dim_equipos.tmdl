	column 'Categoria Riesgo' =
			
			VAR Indice = [@Indice Riesgo Falla]
			RETURN
			    SWITCH(
			        TRUE(),
			        Indice > 1000, "Crítico",
			        Indice > 700, "Alto",
			        "Normal"
			    )
