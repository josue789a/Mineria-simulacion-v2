	/// Ley de concentrado de Cu ponderada por toneladas de concentrado.
	measure 'Ley Concentrado Cu %' = DIVIDE(SUMX(fact_produccion_mineral, fact_produccion_mineral[ley_concentrado_cu_pct] * fact_produccion_mineral[toneladas_concentrado_cu]), SUM(fact_produccion_mineral[toneladas_concentrado_cu]), 0)
		formatString: 0.00
