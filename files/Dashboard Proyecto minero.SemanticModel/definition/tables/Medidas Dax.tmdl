	/// Ley de cabeza de Zn ponderada por toneladas.
	measure 'Ley Zn Cabeza %' = DIVIDE(SUMX(fact_produccion_mineral, fact_produccion_mineral[ley_cabeza_zn_pct] * fact_produccion_mineral[toneladas_procesadas_planta]), [Toneladas Planta], 0)
		formatString: 0.000
