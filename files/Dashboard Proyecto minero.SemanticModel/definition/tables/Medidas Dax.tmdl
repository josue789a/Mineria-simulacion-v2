	/// Toneladas procesadas a nivel PLANTA (flotacion). No confundir con [Total toneladas procesadas] que suma los 10 equipos.
	measure 'Toneladas Planta' = SUM(fact_produccion_mineral[toneladas_procesadas_planta])
