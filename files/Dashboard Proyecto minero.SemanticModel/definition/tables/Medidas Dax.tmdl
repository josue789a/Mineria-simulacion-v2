	/// Texto para titulos dinamicos.
	measure '@Planta Seleccionada' = SELECTEDVALUE(dim_plantas[nombre_planta], "Todas las plantas")
		displayFolder: v2 | Comparacion de plantas
		lineageTag: cc5249cb-0fa6-44d7-80a1-d9e0627b0393

	/// OEE del conjunto de plantas seleccionadas (referencia para comparar).
	measure 'OEE Grupo' = CALCULATE([OEE], ALLSELECTED(dim_plantas))
		formatString: 0.00\ %;-0.00\ %;0.00\ %
		displayFolder: v2 | Comparacion de plantas
		lineageTag: a3ddaa8f-4a6e-4b1e-970d-51d7b771773e

	/// Diferencia de OEE de la planta vs el grupo, en puntos porcentuales.
	measure 'OEE vs Grupo (pp)' = ([OEE] - [OEE Grupo]) * 100
		formatString: +0.00;-0.00;0.00
		displayFolder: v2 | Comparacion de plantas
		lineageTag: f563d6f0-f168-48e5-ad3f-0ff5c043c395

	/// Participacion de la planta en las toneladas del grupo.
	measure 'Toneladas Planta % Grupo' = DIVIDE([Toneladas Planta], CALCULATE([Toneladas Planta], ALLSELECTED(dim_plantas)), 0)
		formatString: 0.00\ %;-0.00\ %;0.00\ %
		displayFolder: v2 | Comparacion de plantas
		lineageTag: 6d0c3be0-f598-4205-be63-dd0981b981ba

	/// Participacion de la planta en la utilidad del grupo.
	measure 'Utilidad % Grupo' = DIVIDE([Utilidad], CALCULATE([Utilidad], ALLSELECTED(dim_plantas)), 0)
		formatString: 0.00\ %;-0.00\ %;0.00\ %
		displayFolder: v2 | Comparacion de plantas
		lineageTag: 74393078-e6d0-48db-a605-da301174d375

