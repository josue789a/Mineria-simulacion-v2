	measure '@Probabilidad Falla' = ```
			
			    DIVIDE(
			        [@Indice Riesgo Falla],
			        MAXX(ALL(dim_equipos[nombre_equipo_planta]), [@Indice Riesgo Falla]),
			        0
			    )
			```
		lineageTag: 0564a5eb-bd51-45ed-861d-dcef35a974ea

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure '@Top 3 Prioridades' = ```
			
			VAR Top3 = 
			    TOPN(
			        3,
			        ALLSELECTED(dim_equipos[nombre_equipo_planta]),
			        [@Indice Riesgo Falla],
			        DESC
			    )
			RETURN
			    CONCATENATEX(
			        Top3,
			        RANKX(Top3, [@Indice Riesgo Falla], , DESC, Dense) & ". " 
			            & dim_equipos[nombre_equipo_planta] 
			            & " (Índice: " & FORMAT([@Indice Riesgo Falla], "0") & ")",
			        UNICHAR(10),
			        [@Indice Riesgo Falla],
			        DESC
			    )
			```
		lineageTag: 39a35bce-15d5-4cb7-80e6-0e40f7c59de3

	measure 'Costo Evitable Selected' =
			
			IF(
			    HASONEVALUE(dim_equipos[nombre_equipo_planta]),
			    [Costo Evitable],
			    BLANK()
			)
		lineageTag: 703297b4-18a1-48c7-88ba-f9f61d1716c2

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'COSTO % Evitable Selected vs Total' =
			
			VAR Selected = [Costo Evitable]
			VAR Total = [Ahorro Potencial Total]
			RETURN
			    IF(
			        NOT(ISBLANK(Selected)),
			        DIVIDE(Selected, Total, 0),
			        BLANK()
			    )
		formatString: 0\ %;-0\ %;0\ %
		lineageTag: 74454ddf-2104-4bc6-bb0f-c913b86f8e7c

	measure 'Ahorro Potencial Total Gauge' =
			
			CALCULATE([Ahorro Potencial Total], ALL(dim_equipos[nombre_equipo_planta]))
		lineageTag: 0ba8a84d-c056-45f9-b175-72c866643ebd

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Costo no confiabilidad Total' =
			
			CALCULATE([Costo No confiabilidad], ALL(dim_equipos[nombre_equipo_planta]),all(DimCalendario[Fecha]))
		lineageTag: fac9fea8-f95b-4e39-8721-aabb66d9f180

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Costo % no confiabilidad ALL' = [Costo No confiabilidad]/[Costo no confiabilidad Total]
		formatString: 0\ %;-0\ %;0\ %
		lineageTag: 1688f19c-3ea3-45fb-8b4a-28edb57736cd

	measure '% Paradas Correctivas' =
			
			DIVIDE(
			    CALCULATE(SUM(fact_paradas[duracion_horas]), fact_paradas[tipo_parada] = "CORRECTIVA"),
			    SUM(fact_paradas[duracion_horas]),
			    0
			)
		lineageTag: 7f944123-80e1-48f3-99c0-cb024dc58ec7

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'HH % Preventivo' = ```
			DIVIDE([HH Preventivo], [HH TOTAL x OT], 0)
			
			```
		formatString: 0.00\ %;-0.00\ %;0.00\ %
		lineageTag: f31d81bc-a0ae-4439-82d8-11c98aeddc25

	measure 'HH  TOTAL' = ([HH TOTAL x OT])
		lineageTag: bab159c1-766d-47d0-af0d-305aa826b3f5

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'HH  ALL TOTAL' = CALCULATE(([HH TOTAL x OT]),ALL(fact_paradas))
		lineageTag: 7fd5a77e-152e-4a6c-8fdf-ae70d27e6bf8

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'HH Promedio por OT ALL' =
			
			DIVIDE(
			    CALCULATE([HH TOTAL x OT], ALL(fact_paradas)),
			    CALCULATE(DISTINCTCOUNT(fact_mantenimiento[orden_id]), ALL(fact_paradas)),
			    0
			)
		lineageTag: bf48ce1c-bcda-45f6-9a59-925cd914d9e9

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Costo Promedio Equipo' =
			
			CALCULATE(
			    AVERAGEX(VALUES(dim_equipos[equipo_id]), [Costo Total No Confiabilidad]),
			    ALLEXCEPT(dim_equipos, dim_equipos[nombre_equipo_planta])
			)
		lineageTag: 2827ea85-763f-4abf-ac86-0335b8fe7cdd

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure @D_Selectedvalue_metrica =
			
			VAR Seleccion = SELECTEDVALUE('Metricas Tendencia'[Metrica], "OEE")
			RETURN
			    SWITCH(
			        Seleccion,
			        "OEE", [OEE_promedio_Planta],
			        "Disponibilidad", [Disponibilidad],
			        "Rendimiento", [Rendimiento],
			        "Calidad", [Calidad],
			        [OEE_promedio_Planta]  // default
			    )
		formatString: 0.0\ %;-0.0\ %;0.0\ %
		lineageTag: 0f0f431d-2df3-40c2-b00f-99b9bf41158e

	measure @D_DayesYTD_Selected_value =
			
			CALCULATE(
			    [@D_Selectedvalue_metrica],
			    DATESYTD(DimCalendario[Fecha])
			)
		formatString: 0.0\ %;-0.0\ %;0.0\ %
		lineageTag: 71c81e64-af6f-467c-a205-9bbd579c5081

	measure '@D_Titulo_Metrica Dinamico' =
			
			VAR Metrica = SELECTEDVALUE('Metricas Tendencia'[Metrica], "OEE")
			VAR AnioSeleccionado = SELECTEDVALUE(DimCalendario[Año])  // Sin default
			RETURN
			    IF(
			        NOT(ISBLANK(AnioSeleccionado)),
			        AnioSeleccionado & ": " & Metrica & " Mensual vs " & Metrica & " YTD",
			        Metrica & " Mensual vs " & Metrica & " YTD"
			    )
		lineageTag: 94358483-2c36-4fa5-b7f5-5e249c7d311f

	measure @D_Titulo_CostoEvitable_Dinamico =
			
			VAR AnioSeleccionado = SELECTEDVALUE(DimCalendario[Año])
			VAR EquipoSeleccionado = SELECTEDVALUE(dim_equipos[nombre_equipo_planta])
			RETURN
			    IF(
			        NOT(ISBLANK(AnioSeleccionado)) && NOT(ISBLANK(EquipoSeleccionado)),
			        "Costo evitable " & AnioSeleccionado & ": " & EquipoSeleccionado,
			        IF(
			            NOT(ISBLANK(AnioSeleccionado)),
			            "Costo evitable " & AnioSeleccionado & ": Todos los equipos",
			            IF(
			                NOT(ISBLANK(EquipoSeleccionado)),
			                "Costo evitable: " & EquipoSeleccionado,
			                "Costo evitable: Todos los equipos"
			            )
			        )
			    )
		lineageTag: 2d0533f6-6e8e-449b-9003-8e5e29ad04ca

	measure 'Total Repuestos Tooltip' =
			CALCULATE(
			    COUNTROWS(fact_mantenimiento),
			    USERELATIONSHIP(fact_mantenimiento[equipo_id], dim_equipos[equipo_id])
			)
		formatString: 0
		lineageTag: 71b627d8-3063-4266-a424-7630ba84c8a6

	/// Ingresos por venta de concentrados (soles).
	measure 'Ingreso Total PEN' = SUM(fact_ventas[ingreso_total_pen])
		formatString: "S/ "#,0;-"S/ "#,0;"S/ "0
