	/// Ley de cabeza de Cu ponderada por toneladas.
	measure 'Ley Cu Cabeza %' = DIVIDE(SUMX(fact_produccion_mineral, fact_produccion_mineral[ley_cabeza_cu_pct] * fact_produccion_mineral[toneladas_procesadas_planta]), [Toneladas Planta], 0)
