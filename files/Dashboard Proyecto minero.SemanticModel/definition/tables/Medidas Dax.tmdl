table 'Medidas Dax'
	lineageTag: db78a84b-01ee-4676-afa7-e900ddf1769a

	measure Disponibilidad =
			
			DIVIDE(
			    SUM(fact_produccion[horas_operativas]),
			    SUM(fact_produccion[horas_operativas]) + SUM(fact_produccion[horas_parada]),
			    0
			)
		formatString: 0.00\ %;-0.00\ %;0.00\ %
		lineageTag: 0b2e9d0a-9fdd-4a8a-a46e-b8501aa92ca6

	measure Rendimiento =
			
			VAR CapacidadReal = SUM(fact_produccion[toneladas_procesadas])
			VAR CapacidadTeorica =
			    SUMX(
			        fact_produccion,
			        fact_produccion[horas_operativas] * RELATED(dim_equipos[capacidad_nominal_tmh])
			    )
			RETURN
			DIVIDE(CapacidadReal, CapacidadTeorica, 0)
		formatString: 0.00\ %;-0.00\ %;0.00\ %
		lineageTag: 6559ccb8-7a6e-4d97-88d7-b60eb915b28f

	measure Calidad =
			
			1 - DIVIDE(
			    SUM(fact_produccion[toneladas_fuera_especificacion]),
			    SUM(fact_produccion[toneladas_procesadas]),
			    0
			)
		formatString: 0.00\ %;-0.00\ %;0.00\ %
		lineageTag: 82747f89-992d-4148-845b-e41119e5a9a2

	measure OEE = [Disponibilidad] * [Rendimiento] * [Calidad]
		formatString: 0.00\ %;-0.00\ %;0.00\ %
		lineageTag: 64bd73a0-16c4-4cd6-b505-7c4b519be963

