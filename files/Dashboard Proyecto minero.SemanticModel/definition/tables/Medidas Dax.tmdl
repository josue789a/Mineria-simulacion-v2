	measure 1Toneladas_area% = ```
			
			VAR ton_procesado = [Total toneladas procesadas]
			VAR ton_anio = 
			    CALCULATE(
			        [Total toneladas procesadas],
			        REMOVEFILTERS(dim_equipos),           // Quita TODOS los filtros de equipos (área + nombre)
			        ALLSELECTED(DimCalendario)            // Mantiene solo el año/mes seleccionado
			    )
