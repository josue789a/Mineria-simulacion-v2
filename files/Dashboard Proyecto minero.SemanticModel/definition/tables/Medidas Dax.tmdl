	measure 'Costo Promedio Area' =
			
			CALCULATE(
			    AVERAGEX(VALUES(dim_equipos[equipo_id]), [Costo Total No Confiabilidad]),
			    ALLEXCEPT(dim_equipos, dim_equipos[area], dim_equipos[planta_id])
			)
