		lineageTag: 9b057e4d-dac0-46ea-97de-14dd892cef54

	/// Ley de cabeza de Ag (g/t) ponderada por toneladas.
	measure 'Ley Ag Cabeza g/t' = DIVIDE(SUMX(fact_produccion_mineral, fact_produccion_mineral[ley_cabeza_ag_gt] * fact_produccion_mineral[toneladas_procesadas_planta]), [Toneladas Planta], 0)
