	measure '2% Seleccionado_vs_Total_Historico' = ```
			
			VAR seleccionado = SUM(fact_produccion[toneladas_procesadas])
			VAR total_years = 
			    CALCULATE(
			        SUM(fact_produccion[toneladas_procesadas]),
			        ALL(dim_equipos),           // Quita área y equipo
			        ALL(DimCalendario)          // Quita AÑO también → total histórico 2024+2025
			    )
			RETURN
			DIVIDE(seleccionado, total_years, 0)
			```
