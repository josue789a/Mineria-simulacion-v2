	/// Fino recuperado / fino contenido de Cu.
	measure 'Recuperacion Cu %' = DIVIDE(SUM(fact_produccion_mineral[fino_recuperado_cu_ton]), SUM(fact_produccion_mineral[fino_contenido_cu_ton]), 0)
