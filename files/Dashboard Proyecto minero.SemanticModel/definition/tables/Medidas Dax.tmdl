	measure Titulo_Tipo_Parada =
			
			VAR TiposSeleccionados = VALUES(fact_paradas[tipo_parada])
			VAR Cantidad = COUNTROWS(TiposSeleccionados)
			VAR TextoConcatenado = CONCATENATEX(TiposSeleccionados, fact_paradas[tipo_parada], ", ")
			RETURN
			    SWITCH(
			        TRUE(),
			        Cantidad = 0, "Duracion en horas de las causas de parada",
			        Cantidad = 1, "Duracion en horas de parada - " & MAX(fact_paradas[tipo_parada]),
			        "Duracion en horas de las causas de parada - " & TextoConcatenado
			    )
		lineageTag: 95c21510-12bc-4bd9-a597-5b06c1df4d69

