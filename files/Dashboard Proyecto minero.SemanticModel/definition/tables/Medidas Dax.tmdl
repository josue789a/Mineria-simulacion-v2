		lineageTag: a1ba2b1e-372e-485a-9ac1-71791f671711

	/// Ranking de plantas por MTTR (menor = mejor).
	measure 'Rank Planta MTTR' = RANKX(ALLSELECTED(dim_plantas[nombre_planta]), [MTTR_Hr], , ASC, Dense)
