	measure 'pareto1_Total Eventos Parada' = COUNTROWS(fact_paradas)
		formatString: 0
		lineageTag: 0cf94ae5-ab04-466b-9384-a9a2687a802a

	measure 'pareto2_Rank Causa' = 
			VAR TotalActual = [pareto1_Total Eventos Parada]
			VAR CausaActual = SELECTEDVALUE(fact_paradas[causa])
			RETURN
			    IF(
			        NOT(ISBLANK(TotalActual)) && TotalActual > 0,
			        RANKX(
			            ALLSELECTED(fact_paradas[causa]),
			            [pareto1_Total Eventos Parada] + (1 - DIVIDE(RANKX(ALLSELECTED(fact_paradas[causa]), fact_paradas[causa], , ASC), 10000)),
			            ,
			            DESC
			        )
			    )
		formatString: 0
		lineageTag: dbcdd3d1-0509-40df-99ca-bae2f1bf9672

	measure pareto3_Eventos_acumulados = ```
			VAR RankActual = [pareto2_Rank Causa]
			VAR TotalActual = [pareto1_Total Eventos Parada]
			RETURN
			    IF(
			        ISBLANK(TotalActual) || TotalActual = 0 || ISBLANK(RankActual),
			        BLANK(),
			        SUMX(
			            FILTER(
			                ALLSELECTED(fact_paradas[causa]),
			                [pareto2_Rank Causa] <= RankActual && [pareto1_Total Eventos Parada] > 0
			            ),
			            [pareto1_Total Eventos Parada]
			        )
			    )
			```
		formatString: 0
		lineageTag: 5a66e148-b272-441f-9094-331c0d566efd

	measure 'pareto4_% del_total' = 
			VAR Acumulado = [pareto3_Eventos_acumulados]
			VAR GranTotal = CALCULATE([pareto1_Total Eventos Parada], ALLSELECTED(fact_paradas[causa]))
			RETURN
			    DIVIDE(Acumulado, GranTotal, 0)
		formatString: 0.00\ %;-0.00\ %;0.00\ %
		lineageTag: 5ab9f1bd-019d-43f5-8b99-0fa77337458b

	measure 'pareto4.1_% del total' = 
			VAR Acumulado = [pareto3_Eventos_acumulados]
			VAR GranTotal = CALCULATE([pareto1_Total Eventos Parada], ALLSELECTED(fact_paradas[causa]))
			RETURN
			    DIVIDE(Acumulado, GranTotal, 0)
		formatString: 0.00\ %;-0.00\ %;0.00\ %
		lineageTag: 3fecbcc8-df7b-4332-a4d5-226b8124d059

	measure pareto5_Clasificacion_ABC =
			
			VAR pct_acumulado = [pareto4.1_% del total]
			RETURN
			    IF(
			        HASONEVALUE(fact_paradas[causa]),
			        SWITCH(
			            TRUE(),
			            pct_acumulado <= 0.8,   "A",
			            pct_acumulado <= 0.95,  "B",
			            "C"
			        ),
			        BLANK()
			    )
		lineageTag: 5cc4fcfd-9390-447c-927d-e3285440f709

