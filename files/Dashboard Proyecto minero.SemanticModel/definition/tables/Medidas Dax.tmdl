		displayFolder: v2 | Financiero
		lineageTag: be397872-a350-4907-9583-74da9b70b1b2

	/// Ingreso por plata (USD).
	measure 'Ingreso Ag USD' = SUM(fact_ventas[ingreso_ag_usd])
		formatString: "US$ "#,0;-"US$ "#,0;"US$ "0
		displayFolder: v2 | Financiero
		lineageTag: a553e5c7-870a-4bd7-b410-001198b476e6

	/// Energia + mano de obra + insumos + otros (soles).
	measure 'Gastos Operativos PEN' = SUM(fact_gastos[monto_soles])
		formatString: "S/ "#,0;-"S/ "#,0;"S/ "0
		displayFolder: v2 | Financiero
		lineageTag: 489b8a19-358d-4084-ad73-1614afb9b8da

	/// Ingreso - gastos operativos - costo de paradas - costo de repuestos (definicion del proyecto v1).
	measure Utilidad = [Ingreso Total PEN] - [Gastos Operativos PEN] - [Costo Total No Confiabilidad]
		formatString: "S/ "#,0;-"S/ "#,0;"S/ "0
		displayFolder: v2 | Financiero
		lineageTag: e6e0e021-40ca-41bb-80db-276cfee017ec

	/// Utilidad / Ingreso.
	measure 'Margen Utilidad %' = DIVIDE([Utilidad], [Ingreso Total PEN], 0)
		formatString: 0.00\ %;-0.00\ %;0.00\ %
		displayFolder: v2 | Financiero
		lineageTag: 88d9e9e5-78df-4f78-b29d-d6bf65ab0d72

	/// Utilidad por tonelada procesada en planta.
	measure 'Utilidad por Tonelada' = DIVIDE([Utilidad], [Toneladas Planta], 0)
		formatString: "S/ "#,0.00
		displayFolder: v2 | Financiero
		lineageTag: 2e57e351-5931-42e6-8ac1-55080fa5aad1

	/// Costo de no confiabilidad (paradas + repuestos) por tonelada de planta.
	measure 'Costo NC por Tonelada' = DIVIDE([Costo Total No Confiabilidad], [Toneladas Planta], 0)
