		lineageTag: 00deeed4-7a9b-44fa-93ef-b2ff75f67dc6

	/// Ingresos por venta de concentrados (USD).
	measure 'Ingreso Total USD' = SUM(fact_ventas[ingreso_total_usd])
		formatString: "US$ "#,0;-"US$ "#,0;"US$ "0
		displayFolder: v2 | Financiero
		lineageTag: caa02c24-9432-4a3e-ae6a-a76fbe70a36d

	/// Ingreso por cobre (USD).
	measure 'Ingreso Cu USD' = SUM(fact_ventas[ingreso_cu_usd])
		formatString: "US$ "#,0;-"US$ "#,0;"US$ "0
		displayFolder: v2 | Financiero
		lineageTag: 61dc9f4e-1837-491d-b41d-47f62029ce64

	/// Ingreso por zinc (USD).
	measure 'Ingreso Zn USD' = SUM(fact_ventas[ingreso_zn_usd])
