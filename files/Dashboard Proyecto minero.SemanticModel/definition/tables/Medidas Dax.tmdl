	measure 'Costo Evitable' = ```
			VAR MiCosto = [Costo Total No Confiabilidad]
			VAR PromedioArea = [Costo Promedio Area]
			VAR ResultadoFila = IF(MiCosto > PromedioArea, MiCosto - PromedioArea, 0)
			VAR ResultadoTotal = 
			    SUMX(
			        ALLSELECTED(dim_equipos[nombre_equipo_planta]),
			        VAR CostoEquipo = [Costo Total No Confiabilidad]
			        VAR PromEquipo = [Costo Promedio Area]
			        RETURN IF(CostoEquipo > PromEquipo, CostoEquipo - PromEquipo, 0)
			    )
			RETURN
			    IF(
			        HASONEVALUE(dim_equipos[nombre_equipo_planta]),
			        ResultadoFila,
			        ResultadoTotal
			    )
			```
		lineageTag: 5353d960-3a7e-4b85-a630-b82ba9e85a48

		annotation PBI_FormatHint = {"isGeneralNumber":true}

