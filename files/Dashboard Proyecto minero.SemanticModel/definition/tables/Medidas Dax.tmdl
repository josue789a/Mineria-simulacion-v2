	measure MTBF_Hr =
			
			VAR HorasOperativas = CALCULATE(SUM(fact_produccion[horas_operativas]))
			VAR NumFallas = CALCULATE(
			    COUNTROWS(fact_paradas),
			    fact_paradas[tipo_parada] = "CORRECTIVA",
			    REMOVEFILTERS(fact_paradas[causa])  // <-- IGNORA filtro de causa
			)
			RETURN DIVIDE(HorasOperativas, NumFallas, 0)
		lineageTag: c1e007b2-55f2-4709-9945-0fdba45a0481

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure Chequeo_Fechas_Huerfanas = ```
			
			CALCULATE(
			    COUNTROWS(fact_paradas),
			    fact_paradas[fecha] < MIN(DimCalendario[Fecha]) || 
