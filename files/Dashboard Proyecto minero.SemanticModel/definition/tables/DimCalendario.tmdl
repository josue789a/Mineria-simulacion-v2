		summarizeBy: none
		sourceColumn: [AñoMes]

	partition DimCalendario = calculated
		mode: import
		source = ```
				
				VAR FechaMin = 
				    MIN(
				        MIN(fact_produccion[fecha]),
				        MIN(fact_paradas[fecha])
				    )
				VAR FechaMax = 
				    MAX(
				        MAX(fact_produccion[fecha]),
				        MAX(fact_paradas[fecha])
				    )
				VAR Fecha = CALENDAR(FechaMin, FechaMax)
				RETURN
				SELECTCOLUMNS(
				    Fecha,
				    "Fecha", [Date],
				    "Año", YEAR([Date]),
				    "Semestre", IF(MONTH([Date])<=6,"S-1","S-2"),
				    "Trimestre", "T-" & QUARTER([Date]),
				    "Mes", FORMAT([Date],"mmmm"),
				    "Mes.abrevt", LEFT(FORMAT([Date],"mmm"),3),
				    "MesNum", MONTH([Date]),
				    "DíaSem", WEEKDAY([Date]),
				    "SemAño", WEEKNUM([Date]),
				    "Dia", FORMAT([Date],"dddd"),
				    "Día.abrevt", LEFT(FORMAT([Date],"dddd"),3),
				    "DíaNum", DAY([Date]),
								    "AñoMes", FORMAT([Date],"yyyy-MM")
				)
				```

	annotation PBI_Id = 1c1f0f94cd664642884a304936478111

